<?xml version="1.0" encoding="UTF-8"?>
<!--
  ROS 2 traffic stays between the observation bridge and agent containers on
  this host. Both use host networking, so loopback is shared. ROS 1 traffic to
  the Stretch is unaffected and continues to use ROS_IP/ROS_MASTER_URI.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" priority="default" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="127.0.0.1"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
